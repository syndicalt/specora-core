# =============================================================================
# Specora Core — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values.
#
# The Forge (compiler + generators) works without any API keys.
# The Factory, Healer (Tier 2-3), Extractor, and Chat require at least
# one AI provider to be configured.
#
# =============================================================================


# =============================================================================
# AI / LLM Providers
# =============================================================================
# At least one provider is required for LLM-powered features.
# Specora auto-detects the provider from whichever key is set.
# Priority: SPECORA_AI_MODEL > ANTHROPIC > OPENAI > XAI > ZAI > GOOGLE > OLLAMA

# --- Model Override (optional) ---
# Force a specific model instead of auto-detection.
# Examples: claude-sonnet-4-6, claude-opus-4-6, gpt-4o, gpt-4o-mini
# Full list: see engine/registry.py
SPECORA_AI_MODEL=

# --- Anthropic (recommended) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- xAI (Grok) ---
# https://console.x.ai/
# Uses OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
# Uses the OpenAI-compatible endpoint at
# https://generativelanguage.googleapis.com/v1beta/openai/
# Auto-selects gemini-2.5-pro.
GOOGLE_API_KEY=

# --- Z.AI (GLM) ---
# https://z.ai — sign up and get key from profile > API Keys
# Free models: glm-4.7-flash, glm-4.5-flash
# Paid models: glm-5.1, glm-5
# OpenAI-compatible at https://api.z.ai/api/paas/v4/
ZAI_API_KEY=

# --- Local Models (Ollama) ---
# Install: https://ollama.com/
# Pull: ollama pull llama3.3:70b
# No API key needed. Uses Ollama's OpenAI-compatible /v1 endpoint;
# either http://localhost:11434 or http://localhost:11434/v1 works.
OLLAMA_BASE_URL=

# Which pulled tag to use. Defaults to llama3.3:70b.
# Tags the registry does not know still run, with minimal assumed
# capabilities (no tool use, no structured output).
OLLAMA_MODEL=


# =============================================================================
# LLM Reliability and Cost
# =============================================================================
# Applies to every provider above.

# Per-request timeout in seconds. Defaults to 60, or 300 for Ollama, since
# local generation on a large model routinely exceeds a minute.
SPECORA_LLM_TIMEOUT=

# Attempts before the call fails. Only transient transport failures are
# retried (timeouts, connection errors, 408/409/425/429/5xx). Other 4xx
# responses propagate on the first attempt.
SPECORA_LLM_MAX_ATTEMPTS=

# Exponential backoff between retries, in seconds.
SPECORA_LLM_BACKOFF=
SPECORA_LLM_MAX_BACKOFF=

# Optional token pricing for cost reporting, as USD per million tokens.
# Token counts are always recorded; dollar estimates appear only for models
# listed here, and the aggregate reports how many calls it could not price.
# Example:
# SPECORA_MODEL_PRICING={"gpt-4o":{"input":2.5,"output":10.0}}
SPECORA_MODEL_PRICING=


# =============================================================================
# Generated App — Database
# =============================================================================
# These apply to the generated runtime app (not specora-core itself).

# Postgres connection string
DATABASE_URL=postgresql://specora:specora@localhost:5432/specora

# Backend selection: postgres | memory
# memory = in-memory dict store (dev/demo, no persistence)
# postgres = asyncpg connection pool (production)
DATABASE_BACKEND=postgres


# =============================================================================
# Generated App — Server
# =============================================================================

# Port the generated FastAPI app listens on
PORT=8000

# Comma-separated CORS origins (* = allow all)
CORS_ORIGINS=*


# =============================================================================
# Generated App — Authentication
# =============================================================================
# Auth is only generated if the domain includes an infra/auth contract.

# Enable/disable auth middleware (true | false)
AUTH_ENABLED=false

# Auth provider: jwt | external
AUTH_PROVIDER=jwt

# JWT signing secret (CHANGE THIS IN PRODUCTION)
AUTH_SECRET=change-me-in-production

# JWT token expiration in minutes
AUTH_TOKEN_EXPIRE_MINUTES=60


# =============================================================================
# Healer Service
# =============================================================================

# The Healer rewrites the contracts that are your source of truth and triggers
# code regeneration. It is the most privileged component in the system, so it
# authenticates on both of its planes and has no anonymous mode: with no
# authenticator configured the control plane returns 503 rather than falling
# open.
#
#   DATA PLANE     /healer/ingest, /healer/status — internal only.
#   CONTROL PLANE  ticket view, approve, reject   — reachable from anywhere.
#
# Do not publish port 8083. The application reaches the Healer over the internal
# network; the control plane belongs behind a reverse proxy.

# Bind address and port. Loopback by default — deliberately not 0.0.0.0.
SPECORA_HEALER_HOST=127.0.0.1
SPECORA_HEALER_PORT=8083

# --- Data plane ---------------------------------------------------------------

# Required for the app to report errors. Network position is not authentication:
# the app container shares this .env, so a compromised sibling could otherwise
# inject unlimited tickets. Generate with: openssl rand -hex 32
SPECORA_HEALER_INGEST_TOKEN=

# Rate limiting is per contract_fqn, because error storms come from one failing
# contract rather than from many clients. The global ceiling is a backstop.
SPECORA_HEALER_INGEST_RATE_PER_MINUTE=60
SPECORA_HEALER_INGEST_BURST=20
SPECORA_HEALER_INGEST_GLOBAL_RATE_PER_MINUTE=600

# --- Control plane (approvals) ------------------------------------------------

# Signs single-use, expiring approval links. This is how an approval stays
# reachable from anywhere without a session or a login page — the link goes out
# in the notification webhook and is burned when used.
SPECORA_HEALER_APPROVAL_SECRET=
SPECORA_HEALER_APPROVAL_TTL_SECONDS=86400

# Base URL used to build those links.
SPECORA_HEALER_PUBLIC_URL=

# Static bearer token, for operators fronting the control plane with their own
# identity provider.
SPECORA_HEALER_OPERATOR_TOKEN=

# Trust an identity header from Cloudflare Access / oauth2-proxy. Leave unset
# unless such a proxy is genuinely in front of the Healer — setting it means
# trusting whatever sends that header.
SPECORA_HEALER_PROXY_IDENTITY_HEADER=

# --- Cost governance ----------------------------------------------------------

# The Healer calls an LLM per ticket. Without a ceiling an error storm is an
# unbounded bill. Token counts are always exact.
SPECORA_HEALER_TOKEN_BUDGET=
SPECORA_HEALER_BUDGET_WINDOW_HOURS=24

# A USD ceiling requires prices for the models in use. Prices are never
# hardcoded — a stale constant misreports spend, which is worse than reporting
# none — so a USD ceiling with an unpriced model refuses to run rather than
# proceeding uncosted. JSON: {"model-id": {"input": usd_per_mtok, "output": ...}}
SPECORA_HEALER_SPEND_LIMIT_USD=
SPECORA_HEALER_MODEL_PRICES=

# Consecutive-failure circuit breaker.
SPECORA_HEALER_BREAKER_FAILURE_THRESHOLD=5
SPECORA_HEALER_BREAKER_COOLDOWN_SECONDS=300

# --- Behaviour ----------------------------------------------------------------

# Minimum proposal confidence for automatic application. The default of 1.0
# means only deterministic normalization auto-applies; every LLM-authored
# proposal waits for a human.
SPECORA_HEALER_AUTO_APPLY_MIN_CONFIDENCE=1.0

# SQLite busy timeout for the ticket queue.
SPECORA_HEALER_DB_BUSY_TIMEOUT_MS=5000

# Webhook URL for healer notifications (optional)
# Posts JSON {ticket_id, status, contract_fqn, explanation} on state changes,
# including a signed approval link when a fix is proposed.
SPECORA_HEALER_WEBHOOK_URL=


# =============================================================================
# Editor
# =============================================================================
# Used by `factory new` to open contracts for review before writing.
# Falls back to terminal preview if neither is set.

EDITOR=
VISUAL=
